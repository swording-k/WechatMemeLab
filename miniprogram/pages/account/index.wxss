.account-page{height:100%;box-sizing:border-box;padding:12px 16px 0}.heading{font-size:24px;font-weight:700;margin:22px 0 18px}.card{background:#fff;border:1px solid #e2e5d7;border-radius:16px;padding:18px;margin-bottom:14px}.label,.note{display:block;color:#69745b;font-size:12px;line-height:1.8}.account-id{display:block;font-size:16px;font-weight:600;word-break:break-all;margin:5px 0 10px}.tag{display:inline-block;background:#e9efce;color:#536337;padding:4px 8px;font-size:11px;border-radius:6px}.balance{display:flex;justify-content:space-between;align-items:center;margin:20px 0 8px;font-size:14px}.points{font-size:30px;font-weight:700}.section-title{font-size:16px;font-weight:650;margin-bottom:10px}input{background:#f7f7ef;border:1px solid #dfe2d3;box-sizing:border-box;border-radius:10px;height:48px;padding:0 12px;font-size:18px;letter-spacing:4px;margin:14px 0 10px}.product{margin-top:10px;background:#d5ed73}.order{border-top:1px solid #eef0e7;padding:12px 0}.order-id{display:block;word-break:break-all;font-size:11px;color:#69745b}.order-status{display:flex;align-items:center;justify-content:space-between;font-size:13px;margin-top:8px}.order button{font-size:12px;line-height:30px}.message,.error{display:block;font-size:13px;line-height:1.8;margin:12px 0}.message{color:#536337}.error{color:#a14532}.bottom-space{height:calc(24px + env(safe-area-inset-bottom))}

.amount-options{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0}.amount-options button{flex:1;min-width:50px;font-size:13px;margin:0;padding:0 8px}

.website-url{display:block;word-break:break-all;font-size:12px;line-height:1.7;color:#536337;margin:10px 0}.website-card .product{margin-bottom:12px}
