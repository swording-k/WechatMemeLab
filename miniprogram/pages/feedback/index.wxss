.form{padding:22px;display:flex;flex-direction:column;gap:18px}.title{font-size:22px;font-weight:bold}.pick,input,textarea{padding:12px;background:#fff;border:1px solid #dfe2d3;border-radius:10px;font-size:15px}textarea{box-sizing:border-box;width:100%;height:150px}.note{font-size:12px;color:#7b826e;line-height:1.8}.attachments{display:flex;gap:12px}.attachments image{width:80px;height:80px;border-radius:8px}.attachments>view{display:flex;flex-direction:column;gap:6px;font-size:12px}
