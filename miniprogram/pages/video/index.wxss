@import "../editor/index.wxss";
.headline .change{margin:0;padding:0 10px;line-height:30px;font-size:12px;border:1px solid #dfe2d3;background:#fff}.video-stage{position:relative;height:27vh;min-height:150px;flex-shrink:0;overflow:hidden;border-radius:14px;background:#e9ecdf;display:flex;align-items:center;justify-content:center}.source-video{width:100%;height:100%}.output-canvas{width:100%;height:100%;object-fit:contain}.empty{font-size:13px;color:#59634a;text-align:center;padding:25px}.stage-label{position:absolute;bottom:5px;left:8px;background:#ffffffdb;color:#374329;padding:3px 7px;border-radius:6px;font-size:10px;pointer-events:none}.section-line{display:flex;align-items:center;justify-content:space-between;font-size:13px}.field-label{font-size:13px;color:#3f4934}.muted{color:#677353;font-size:11px}.panel{gap:8px}.row>view{flex:1}.row picker{flex:1}.pick{font-size:12px;text-align:center}textarea{width:100%;height:64px;background:#fff;border:1px solid #dfe2d3;border-radius:12px;padding:10px;box-sizing:border-box;font-size:15px}.crop-heading button{font-size:12px;margin:0}.crop-sheet>.primary{width:100%}.tabs .tab{font-size:13px}.export .status{max-height:34px;overflow:auto}.output-canvas[hidden],.source-video[hidden]{display:none}

.panel slider{margin:0 18px}

.crop-video-stage{position:relative;width:min(100%,60vh);height:min(calc(100vw - 40px),60vh);align-self:center;background:#222;overflow:hidden}.crop-video-stage video{position:absolute;inset:0;width:100%;height:100%}.crop-touch{position:absolute;inset:0;z-index:1}.crop-shade{position:absolute;background:#0008;pointer-events:none}.crop-box{position:absolute;border:2px solid #d5ed73;box-sizing:border-box;pointer-events:none}.crop-handle{position:absolute;width:16px;height:16px;background:#d5ed73}.nw{left:-8px;top:-8px}.ne{right:-8px;top:-8px}.sw{left:-8px;bottom:-8px}.se{right:-8px;bottom:-8px}.crop-third{position:absolute;background:#ffffff90}.crop-third.v{width:1px;height:100%}.crop-third.h{height:1px;width:100%}.crop-third.v.a{left:33.33%}.crop-third.v.b{left:66.67%}.crop-third.h.a{top:33.33%}.crop-third.h.b{top:66.67%}
