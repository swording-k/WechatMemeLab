.studio{height:100%;box-sizing:border-box;padding:10px 16px calc(8px + env(safe-area-inset-bottom));display:flex;flex-direction:column;gap:10px}.headline{display:flex;justify-content:space-between;align-items:center;font-size:14px;font-weight:700;flex-shrink:0}.help{font-size:12px;color:#71833d;padding:5px}.stage{flex-shrink:0;position:relative;align-self:center;width: min(100%, 33vh);aspect-ratio:1;border-radius:16px;overflow:hidden;background:#eeeede}.canvas{width:100%;height:100%}.hint{position:absolute;bottom:4px;left:0;right:0;text-align:center;font-size:10px;background:#ffffffbf;padding:3px 0;pointer-events:none}.tabs{display:flex;flex-shrink:0;border-bottom:1px solid #dfe2d3}.tab{flex:1;text-align:center;padding:10px 0;color:#848977;font-size:14px}.active{color:#293122;font-weight:700;border-bottom:3px solid #9fb64e}.tools{flex:1;min-height:70px;height:0}.panel{display:flex;flex-direction:column;gap:12px;padding:4px 0 10px}.row{display:flex;gap:6px;flex-wrap:wrap}.row button{font-size:12px;line-height:34px;padding:0 10px}input{background:white;border:1px solid #dfe2d3;border-radius:10px;padding:12px;font-size:16px;min-height:26px}.presets{display:grid;grid-template-columns:1fr 1fr;gap:8px}.preset{padding:11px;border:1px solid #dfe2d3;background:white;border-radius:12px;display:flex;flex-direction:column;gap:4px;font-size:13px}.chosen{background:#eef5cf;border-color:#9cb345}.export{flex-shrink:0;border-top:1px solid #dfe2d3;padding-top:8px}.export>.primary{width:100%;line-height:44px}.status{display:block;text-align:center;margin-top:5px;font-size:11px}.result{display:flex;align-items:center;gap:8px;margin-top:7px}.result image{width:40px;height:40px;border-radius:8px}.result button{font-size:12px;flex:1;line-height:36px}slider{margin:0 8px}
.row{flex-direction:row}.row button{flex:1;margin:0;width:auto;min-width:0}.stage{border:1px solid #e3e5d9}.preset .muted{font-size:11px}
