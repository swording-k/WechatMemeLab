@import "../editor/index.wxss";
.video{width:100%;height:28vh;flex-shrink:0;border-radius:14px;background:#222}.empty{height:22vh;display:flex;align-items:center;justify-content:center;color:#7b826e;font-size:13px;background:#eceede;border-radius:16px;flex-shrink:0}.row>view{flex:1;font-size:12px}.row input{margin-top:6px;font-size:14px}textarea{width:100%;height:70px;background:#fff;border:1px solid #dfe2d3;border-radius:12px;padding:10px;box-sizing:border-box;font-size:15px}.pick{font-size:12px}.hidden-canvas{position:fixed;left:-1000px;top:-1000px;width:240px;height:240px}
