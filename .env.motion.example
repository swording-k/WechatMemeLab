# Copy to .env.motion.local. Keep API keys on this machine, never in browser/VITE variables.
DASHSCOPE_API_KEY=
# Beijing key; for a workspace host replace this with its official API host.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
MOTION_PORT=8790
# Conservative reserved costs, not the final provider bill. Uncertain jobs keep their reservation.
MOTION_BUDGET_CNY=3
MOTION_MAX_JOBS=2

# Explicit owner-authorized testing only: true disables both local and cloud test caps.
# Keeps estimated usage records; does not change provider billing. Defaults to capped mode.
MOTION_TEST_UNLIMITED=false
