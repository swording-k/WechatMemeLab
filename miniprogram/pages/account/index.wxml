<scroll-view class="account-page" scroll-y>
 <mode-nav current="account" />
 <view class="heading">我的账户</view>
 <view class="card website-card">
  <view class="section-title">怪相馆网页版 · AI 创作</view>
  <text class="note">一句话生图、给照片改图、让静图动起来，这些 AI 功能在网页版提供，小程序保留照片和视频工具。</text>
  <text class="website-url" selectable>{{websiteUrl}}</text>
  <button class="product" bindtap="copyWebsite">复制网页版网址</button>
  <text class="note">复制后在 Safari、Chrome 等浏览器中粘贴打开。网页登录时，获取 8 位登录码，再回到本页确认即可。</text>
 </view>
 <view class="card" wx:if="{{error}}"><text class="error">{{error}}</text><text class="note" wx:if="{{!account}}">微信账户未连接，可点底部刷新重试。</text></view>
 <view class="card" wx:if="{{account}}">
  <text class="label">账户编号</text><text class="account-id" selectable>{{account.number || account.id}}</text>
  <text class="tag">微信已登录</text>
 </view>
 <view class="card" wx:else><text class="note">{{loading ? '正在使用微信自动登录…' : '微信账户未连接，请点击下方重新连接'}}</text></view>
 <view class="card" wx:if="{{account}}">
  <view class="section-title">登录网页版</view>
  <text class="note">在网页版获取 8 位登录码后填在这里，确认后网页会登录你的账户。</text>
  <input type="number" maxlength="8" value="{{loginCode}}" bindinput="codeInput" disabled="{{busy}}" placeholder="输入网页版登录码" aria-label="网页版登录码" />
  <button class="product" bindtap="confirmLogin" disabled="{{busy}}">确认登录网页版</button>
 </view>
 <view class="card" wx:if="{{notice}}"><text class="message">{{notice}}</text></view>
 <view class="card" wx:if="{{orders.length}}">
  <view class="section-title">历史订单</view><text class="note" wx:if="{{queryError}}">{{queryError}}</text>
  <text class="note" wx:if="{{!orders.length}}">暂无历史订单</text>
  <view class="order" wx:for="{{orders}}" wx:key="id"><text class="order-id" selectable>{{item.id}}</text><view class="order-status"><text>{{item.statusText}}</text><button wx:if="{{item.canQuery}}" data-id="{{item.id}}" bindtap="queryOrder" disabled="{{busy}}">查询到账</button></view></view>
 </view>

 <button bindtap="refresh" disabled="{{loading || busy}}">{{loading ? '正在刷新…' : '刷新账户'}}</button>
 <view class="bottom-space"></view>
</scroll-view>
