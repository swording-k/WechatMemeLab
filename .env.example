# Server-only. Never prefix secrets with VITE_. Copy to ignored .env.local.
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimax.cn
# Zero disables paid creation; set an explicitly approved test budget.
AI_BUDGET_CNY=0
AI_PORT=8787
# For a public single-process server, configure these and a persistent data volume.
# AI_HOST=0.0.0.0
# AI_ACCESS_TOKEN=
# AI_ALLOWED_ORIGINS=https://swording-k.github.io
# AI_DATA_DIR=/persistent/meme-ai
# Frontend builds may contain this public URL, never the MiniMax key.
# VITE_AI_API_BASE=https://your-ai-server.example/api/ai
