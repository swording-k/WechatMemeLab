<view class="studio"><view class="headline"><text>把这一秒，变成你的表情</text></view><video wx:if="{{path}}" id="video" src="{{path}}" class="video" controls show-fullscreen-btn="false" object-fit="contain"/><view wx:else class="empty">先选一小段视频，看看哪一秒最有戏。</view>
<scroll-view scroll-y class="tools"><view class="panel"><button class="primary" disabled="{{busy}}" bindtap="choose">选择视频</button><text class="muted">{{name}} · 最长取 6 秒 · 本机编辑 · GIF 无声音</text><view class="row"><button wx:for="{{modes}}" wx:key="id" data-mode="{{item.id}}" bindtap="mode" class="{{selected===item.id?'primary':''}}">{{item.title}}</button></view><view class="row"><view>开始（秒）<input type="digit" value="{{start}}" data-key="start" bindinput="number"/></view><view>结束（秒）<input type="digit" value="{{end}}" data-key="end" bindinput="number"/></view></view><textarea maxlength="60" value="{{caption}}" placeholder="写一句只有你们懂的话，最多三行" bindinput="caption"/><text class="muted">字幕大小</text><slider min="0.06" max="0.2" step="0.01" value="{{font}}" bindchange="font"/><text class="muted">字幕上下位置</text><slider min="0.1" max="0.95" step="0.01" value="{{ty}}" bindchange="textY"/><view class="row"><picker range="{{speeds}}" bindchange="speed"><view class="pick">速度 {{playbackSpeed}}× ▾</view></picker><picker range="{{ratios}}" bindchange="ratio"><view class="pick">{{square?'方形取景':'保持原比例'}} ▾</view></picker><picker range="{{sizes}}" bindchange="size"><view class="pick">{{outputSize}} px ▾</view></picker></view><text wx:if="{{square}}" class="muted">方形取景放大</text><slider wx:if="{{square}}" min="1" max="3" step="0.05" value="{{zoom}}" bindchange="zoom"/>
</view></scroll-view><view class="export"><button class="primary" disabled="{{!path||busy}}" loading="{{busy}}" bindtap="generate">{{busy?status:'生成 GIF'}}</button><button wx:if="{{busy}}" bindtap="cancel">取消生成</button><view class="result" wx:if="{{gifPath}}"><image src="{{gifPath}}" mode="aspectFit" bindtap="previewGif"/><button bindtap="saveGif">保存到相册</button></view><text class="status muted">{{status}}</text></view><canvas type="2d" id="frames" class="hidden-canvas"/></view>
