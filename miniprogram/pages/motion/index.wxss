.motion-studio{height:100%;box-sizing:border-box;padding:12px 16px calc(10px + env(safe-area-inset-bottom));display:flex;flex-direction:column;gap:10px}.headline{display:flex;justify-content:space-between;align-items:center;font-size:16px;font-weight:700}.free{font-size:12px;font-weight:400;color:#52612f}.result-stage{height:26vh;min-height:150px;flex-shrink:0;background:#e9ecdf;border-radius:14px;overflow:hidden;display:flex;align-items:center;justify-content:center}.result-stage video,.result-stage image{width:100%;height:100%}.empty{padding:24px;text-align:center;color:#52612f;font-size:14px;line-height:1.8}.service{font-size:11px;color:#52612f;flex-shrink:0}.motion-form{flex:1;height:0;min-height:100px}.motion-form>button{width:100%}.tabs{display:flex;gap:8px;margin:14px 0}.tabs button{flex:1;font-size:14px}.selected{background:#e9efce;font-weight:600}.fields{display:flex;flex-direction:column;gap:9px;margin-bottom:16px;font-size:14px}textarea,input{width:100%;box-sizing:border-box;background:#fff;border:1px solid #dfe2d3;border-radius:10px;padding:12px;font-size:16px}textarea{height:100px}input{height:46px}.ideas{display:flex;gap:6px}.ideas button{font-size:12px;flex:1;padding:0 8px;line-height:34px}.note{display:block;font-size:11px;line-height:1.7;color:#52612f;margin-bottom:10px}.reference{width:100%;height:150px}.motion-actions{border-top:1px solid #dfe2d3;padding-top:9px;flex-shrink:0}.motion-actions .primary{width:100%;line-height:44px}.status{display:block;font-size:12px;color:#3f4d2a;line-height:1.6;margin-bottom:8px;max-height:58px;overflow:auto}.again{margin-top:7px;width:100%;line-height:30px;font-size:12px}
.price-link{margin:0;padding:0;background:transparent;color:#52612f;font-size:11px;line-height:24px}.price-link::after{border:0}.picture-actions{display:flex;gap:8px;margin-bottom:8px}.picture-actions button{flex:1;font-size:13px;line-height:36px}.family-tabs{margin:0 0 10px}.family-tabs button{line-height:38px}.motion-form>button{margin-bottom:14px}.result-stage{height:24vh;min-height:136px}
