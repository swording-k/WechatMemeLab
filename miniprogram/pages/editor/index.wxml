<view class="studio">
 <view class="headline"><text>一张照片，整点怪相</text><text class="help" bindtap="help">怎么发送？</text></view>
 <view class="stage"><canvas type="2d" id="preview" class="canvas" bindtouchstart="touchStart" catchtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchEnd"/><view class="hint">{{hint}}</view></view>
 <view class="tabs"><view wx:for="{{tabs}}" wx:key="id" class="tab {{tool===item.id?'active':''}}" data-tool="{{item.id}}" bindtap="switchTool">{{item.title}}</view></view>
 <scroll-view scroll-y class="tools">
  <view wx:if="{{tool==='photo'}}" class="panel"><button class="primary" bindtap="choosePhoto">{{hasPhoto?'换张照片':'上传自己或朋友的照片'}}</button><view class="row"><button bindtap="fit">完整照片</button><button bindtap="fill">铺满画面</button><button bindtap="resetPhoto">重置取景</button></view><text class="muted">直接在上面的照片中拖动，双指缩放，框内所见即导出内容。</text></view>
  <view wx:if="{{tool==='effects'}}" class="panel presets"><view wx:for="{{templates}}" wx:key="id" class="preset {{selected===item.id?'chosen':''}}" data-id="{{item.id}}" bindtap="chooseEffect"><text>{{item.title}}</text><text class="muted">{{item.tag}}</text></view></view>
  <view wx:if="{{tool==='text'}}" class="panel"><input disabled="{{busy}}" maxlength="20" value="{{caption}}" placeholder="写一句欠欠的话…" bindinput="captionInput" bindfocus="pause" bindblur="resume"/><view class="row"><button wx:for="{{suggestions}}" wx:key="*this" data-text="{{item}}" bindtap="suggest">{{item}}</button></view><view class="row"><button data-delta="-3" bindtap="textSize">字小点</button><button data-delta="3" bindtap="textSize">字大点</button><button bindtap="textStyle">{{plain?'加描边':'去描边'}}</button></view><text class="muted">在上面的照片中拖动，可以调整文字位置。</text></view>
  <view wx:if="{{tool==='motion'}}" class="panel"><text>动作幅度</text><slider min="10" max="100" value="{{intensity}}" activeColor="#869d35" bindchange="intensityChange"/><view class="row"><button bindtap="speedChange">{{speedLabel}}</button><button bindtap="undo" disabled="{{!canUndo}}">撤销</button><button bindtap="redo" disabled="{{!canRedo}}">重做</button></view><view wx:if="{{selected==='custom'}}" class="row"><button wx:for="{{sculptModes}}" wx:key="id" data-kind="{{item.id}}" bindtap="sculptMode" class="{{sculpt===item.id?'primary':''}}">{{item.title}}</button></view><text class="muted">{{selected==='custom'?'拖动照片捏出动作；鼓起和缩小轻点即可。':'点照片，选择脸或想变形的位置。'}}</text></view>
 </scroll-view>
 <view class="export"><button class="primary" loading="{{busy}}" disabled="{{busy||!ready}}" bindtap="exportGif">{{busy?status:'生成 GIF 表情'}}</button><view class="result" wx:if="{{gifPath}}"><image src="{{gifPath}}" mode="aspectFit" bindtap="previewGif"/><button bindtap="saveGif">保存到相册</button><button bindtap="help">发送教程</button></view><text class="muted status">{{status}}</text></view>
</view>
