<view class="studio" hidden="{{cropping}}">
 <mode-nav current="editor"/>
 <view class="headline"><text>一张照片，整点怪相</text></view>
 <view class="stage"><canvas type="2d" id="preview" class="canvas" bindtouchstart="touchStart" catchtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchEnd"/><view class="hint">{{hint}}</view></view>
 <view class="quick"><button bindtap="togglePlay">{{playing?'暂停，返回编辑':'播放成品'}}</button><button bindtap="undo" disabled="{{!canUndo}}">撤销</button><button bindtap="redo" disabled="{{!canRedo}}">重做</button></view>
 <view class="tabs"><view wx:for="{{tabs}}" wx:key="id" class="tab {{tool===item.id?'active':''}}" data-tool="{{item.id}}" bindtap="switchTool">{{item.title}}</view></view>
 <scroll-view scroll-y class="tools">
  <view wx:if="{{tool==='photo'}}" class="panel"><button class="primary" bindtap="choosePhoto">{{hasPhoto?'换张照片':'上传自己或朋友的照片'}}</button><view class="row"><button class="primary" bindtap="openCrop">框选照片区域</button></view><view class="row"><button bindtap="fit">完整照片</button><button bindtap="fill">铺满画面</button><button bindtap="resetPhoto">重置取景</button></view><button bindtap="detectFaces">定位照片里的人脸</button><view class="row" wx:if="{{faces.length}}"><button wx:for="{{faces}}" wx:key="index" data-index="{{index}}" bindtap="selectFace">人物 {{index+1}}</button></view><text class="muted">{{faceStatus}}</text><text class="muted">直接在上面的照片中拖动，双指缩放，框内所见即导出内容。</text></view>
  <view wx:if="{{tool==='effects'}}" class="panel"><text class="muted">先看示例动作，点选后用你的照片制作</text><view class="presets"><view wx:for="{{templates}}" wx:key="id" class="preset {{selected===item.id?'chosen':''}}" data-id="{{item.id}}" bindtap="chooseEffect"><image class="preset-preview" src="/assets/previews/{{item.id}}.gif" mode="aspectFill" lazy-load/><view class="preset-copy"><text class="preset-title">{{item.title}}</text><text class="muted">{{selected===item.id?'✓ 已选 · ':''}}{{item.tag}}</text></view></view></view></view>
  <view wx:if="{{tool==='text'}}" class="panel"><input disabled="{{busy}}" maxlength="20" value="{{caption}}" placeholder="写一句欠欠的话…" bindinput="captionInput" bindfocus="pause" bindblur="resume"/><view class="row"><button wx:for="{{suggestions}}" wx:key="*this" data-text="{{item}}" bindtap="suggest">{{item}}</button></view><view class="row"><button data-delta="-3" bindtap="textSize">字小点</button><button data-delta="3" bindtap="textSize">字大点</button></view><picker range="{{styleNames}}" bindchange="changeStyle"><view class="pick">文字效果：{{captionStyleName}} ▾</view></picker>
<view class="row"><button wx:for="{{colors}}" wx:key="*this" style="background:{{item}};color:{{item==='#293122'?'#fff':'#293122'}}" data-target="captionColor" data-color="{{item}}" bindtap="color">字</button></view>
<input value="{{textColor}}" maxlength="7" placeholder="自定义文字颜色，例如 #ffffff" data-target="captionColor" bindchange="hexColor"/><view class="row"><button data-y="32" bindtap="captionPosition">顶部</button><button data-y="160" bindtap="captionPosition">中间</button><button data-y="292" bindtap="captionPosition">底部</button><button bindtap="resetText">重置文字</button></view><text class="muted">拖动文字定位，双指缩放和旋转。</text></view>
  <view wx:if="{{tool==='motion'}}" class="panel"><view class="row" wx:if="{{selected==='cat'||selected==='dog'}}"><button data-layer="pet" bindtap="selectLayer" class="{{layer==='pet'?'primary':''}}">编辑猫狗贴图</button><button data-layer="effect" bindtap="selectLayer">效果位置</button><button bindtap="resetPet">重置贴图</button></view><text class="muted" wx:if="{{layer==='pet'}}">直接拖动贴图，双指缩放旋转，不改变脸的位置。</text><text>动作幅度</text><slider min="10" max="100" value="{{intensity}}" activeColor="#869d35" bindchange="intensityChange"/><view class="row"><button bindtap="speedChange">{{speedLabel}}</button><button bindtap="undo" disabled="{{!canUndo}}">撤销</button><button bindtap="redo" disabled="{{!canRedo}}">重做</button></view><view wx:if="{{selected==='custom'}}" class="row"><button wx:for="{{sculptModes}}" wx:key="id" data-kind="{{item.id}}" bindtap="sculptMode" class="{{sculpt===item.id?'primary':''}}">{{item.title}}</button></view><text>作用范围</text><slider min="0.03" max="0.48" step="0.01" value="{{scope/100}}" data-key="radius" bindchange="tune"/><view wx:if="{{selected==='custom'}}"><text>笔刷范围</text><slider min="0.08" max="0.4" step="0.01" value="{{brushRadius}}" bindchange="brushChange"/><button bindtap="clearSculpt">清空自由捏图</button></view><text>照片背景</text><input value="{{background}}" maxlength="7" placeholder="自定义背景色，例如 #fff8ed" data-target="background" bindchange="hexColor"/><view class="row"><button wx:for="{{backgrounds}}" wx:key="*this" style="background:{{item}}" data-target="background" data-color="{{item}}" bindtap="color">●</button></view><text class="muted">{{selected==='custom'?'拖动照片捏出动作；鼓起和缩小轻点即可。':'点照片，选择脸或想变形的位置。'}}</text></view>
 </scroll-view>
 <view class="export"><view class="export-options"><picker range="{{sizes}}" bindchange="exportSize"><text>导出 {{exportSize}} × {{exportSize}} ▾</text></picker><text bindtap="help">发送教程</text><text bindtap="about">关于与反馈</text></view><text wx:if="{{exportUsage}}" class="muted status">{{exportUsage}}</text><button class="primary" loading="{{busy}}" disabled="{{busy||!ready}}" bindtap="exportGif">{{busy?status:'生成 GIF 表情'}}</button><view class="result" wx:if="{{gifPath}}"><image src="{{gifPath}}" mode="aspectFit" bindtap="previewGif"/><button bindtap="saveGif">保存到相册</button><button bindtap="help">发送教程</button></view><text class="muted status">{{status}}</text></view>
</view>

<view wx:if="{{cropping}}" class="crop-sheet"><view class="crop-heading"><text>框选照片区域</text><button bindtap="cancelCrop">取消</button></view><text class="muted">拖动选框移动，拖四角缩放；可重新画一个框。</text><canvas type="2d" id="crop" class="crop-canvas" bindtouchstart="cropStart" catchtouchmove="cropMove" bindtouchend="cropEnd" bindtouchcancel="cropEnd"/><view class="row"><button bindtap="redrawCrop">重新画选区</button><button class="primary" bindtap="applyCrop">使用这个区域</button></view></view>
